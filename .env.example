# Copy to .env and fill in. .env is git-ignored; this file is the tracked template.
# Never commit real values here.

# --- Fundable REST (primary data source) ---
FUNDABLE_API_KEY=vg_xxxxxxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FUNDABLE_BASE_URL=https://www.tryfundable.ai/api/v1

# --- Exa (recency / long-tail enrichment) ---
# Use the Fundable-owned key, not the Enactus one.
EXA_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- OpenRouter (angle selection + writer) ---
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Supabase (cache + request log) ---
# Reuses an existing project; tables are prefixed pz_. Run supabase/migrations/*.sql.
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- This API's own auth (v1: single static bearer, Fundable-internal) ---
# Generate with: openssl rand -hex 32
PERSONALIZE_API_KEY=
PERSONALIZE_RATE_LIMIT_PER_HOUR=120
