# Copy to .env and fill in. .env is git-ignored; this file is the tracked template.
# Never commit real values here.

# --- Fundable REST (primary data source) ---
FUNDABLE_API_KEY=vg_xxxxxxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FUNDABLE_BASE_URL=https://www.tryfundable.ai/api/v1

# --- Exa (recency / long-tail enrichment) ---
# Use the Fundable-owned key, not the Enactus one.
EXA_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- OpenRouter (angle selection + writer) ---
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Neon (cache + request log) ---
# Apply db/migrations/*.sql in filename order, then `npm run verify:db`.
# Unset means the cache and request log silently no-op, so set it BEFORE deploying.
# This one string is host + user + password: server-side only, never in a browser.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# --- This API's own auth (v1: single static bearer, Fundable-internal) ---
# Generate with: openssl rand -hex 32
PERSONALIZE_API_KEY=
PERSONALIZE_RATE_LIMIT_PER_HOUR=120

# --- n8n find-LinkedIn (optional; step 1 of the flow) ---
# The "Resolve LinkedIn Profile" workflow (bpx0okgj6Tslhwcb), exposed as a
# webhook. UNSET IS A SUPPORTED STATE: the step no-ops and a lead with no
# LinkedIn URL is classified from its email alone, exactly as it is today.
# Set it and a nameless-URL lead gets resolved through Quick Enrich -> AI Ark ->
# Apollo -> Exa/Gemini before classification.
N8N_LINKEDIN_WEBHOOK_URL=
# Value of the `x-api-key` header n8n's Header Auth credential checks. Leave
# blank only if the webhook is unauthenticated (it should not be).
N8N_LINKEDIN_WEBHOOK_TOKEN=
