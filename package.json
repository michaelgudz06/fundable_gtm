{
  "name": "personalize-api",
  "version": "0.1.0",
  "private": true,
  "description": "Fundable Personalization API — person + trigger in, voice-matched copy + evidence out.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --build --force",
    "test": "npm run test --workspaces --if-present",
    "smoke": "npm run smoke --workspace @fundable/shared",
    "verify:supabase": "tsx scripts/verify-supabase.ts",
    "dev": "npm run dev --workspace @fundable/api"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22"
  }
}
